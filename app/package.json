{
  "name": "subtitle-translator",
  "version": "1.0.0",
  "description": "Subtitle Translator — 字幕翻译工具，浏览器本地拆分/合并，Cloudflare Worker 仅做无状态转发",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . --noEmit && vite build && tsx scripts/prerender.ts",
    "preview": "vite preview",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
    "eld": "^2.1.0",
    "segmentit": "^2.0.3"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.2.0",
    "javascript-obfuscator": "^4.1.1",
    "js-yaml": "^5.3.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tsx": "^4.23.12",
    "typescript": "^5.6.2",
    "unified": "^11.0.5",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5"
  }
}
