{
  "name": "montage-subtitle-translator",
  "version": "1.0.0",
  "description": "Montage Subtitle Translator — Free online subtitle translation with privacy-first client-side parsing and a stateless Worker API.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . --noEmit && tsx scripts/checkI18n.ts && tsx scripts/checkLogicalCss.ts && tsx scripts/checkModelCatalog.ts && vite build && tsx scripts/prerender.ts && tsx scripts/emitBuildManifest.ts",
    "preview": "vite preview",
    "typecheck": "tsc -p . --noEmit",
    "i18n:check": "tsx scripts/checkI18n.ts",
    "rtl:check": "tsx scripts/checkLogicalCss.ts",
    "models:check": "tsx scripts/checkModelCatalog.ts",
    "lexicon:build": "tsx scripts/buildLexicon.ts"
  },
  "dependencies": {
    "eld": "^2.1.0",
    "jszip": "^3.10.1",
    "onnxruntime-web": "1.30.0",
    "segmentit": "^2.0.3",
    "tiny-segmenter": "^0.2.0"
  },
  "devDependencies": {
    "@noble/hashes": "^2.4.0",
    "@stdlib/datasets-female-first-names-en": "^0.2.3",
    "@stdlib/datasets-male-first-names-en": "^0.2.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.2.0",
    "js-yaml": "^5.3.0",
    "most-common-words-by-language": "^3.0.14",
    "postcss": "^8.5.26",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "stopwords-iso": "^1.1.0",
    "tsx": "^4.23.12",
    "typescript": "^5.6.2",
    "unified": "^11.0.5",
    "vite": "^5.4.8"
  }
}
