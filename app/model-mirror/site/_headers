/*
  X-Robots-Tag: noindex
  X-Content-Type-Options: nosniff
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin

/blobs/*
  Cache-Control: public, max-age=31536000, immutable

/models/*
  Cache-Control: no-cache

/index.json
  Cache-Control: no-cache

/registry.json
  Cache-Control: no-cache
